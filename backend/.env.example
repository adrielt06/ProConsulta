# Copiar como .env en esta carpeta (backend/) y completar. El .env no se commitea.

# Clave con la que se firman los JWT. Mínimo 32 bytes aleatorios.
# Generar una en PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=cambiar
